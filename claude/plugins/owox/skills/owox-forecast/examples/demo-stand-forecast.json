  },
  "spend_monthly": {
   "label": "Ad spend by month · Unified Ad Spend",
   "data_mart_id": "24ae7b9d-8ccc-4db6-a77b-3b932c59b9fb",
   "scope": "trailing",
   "months": 24,
   "date_field": "date",
   "input": {
    "fields": [
     "date",
     "spend"
    ],
    "aggregations": [
     {
      "field": "spend",
      "function": "SUM"
     }
    ],
    "date_buckets": [
     {
      "field": "date",
      "unit": "MONTH"
     }
    ],
    "sort": [
     {
      "field": "date",
      "direction": "asc"
     }
    ],
    "limit": 1000
   }
  },
  "new_customers_monthly": {
   "label": "New customers by first order month · Customer Acquisition",
   "data_mart_id": "6617ae52-3512-4ebc-9313-770804141aab",
   "scope": "trailing",
   "months": 24,
   "date_field": "first_order_date",
   "input": {
    "fields": [
